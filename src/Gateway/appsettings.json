{
  "CorsOrigins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:8080" ],
  "Jwt": {
    "Issuer": "apitienda",
    "Audience": "apitienda_users",
    "PublicKeyPath": "/app/keys/public.pem"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/auth/{**catch-all}" } },
      "users": { "ClusterId": "users", "Match": { "Path": "/api/users/{**catch-all}" } },
      "products": { "ClusterId": "products", "Match": { "Path": "/api/product/{**catch-all}" } },
      "authSwagger": { "ClusterId": "auth", "Match": { "Path": "/swagger/auth/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger/auth" } ] },
      "usersSwagger": { "ClusterId": "users", "Match": { "Path": "/swagger/users/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger/users" } ] },
      "productsSwagger": { "ClusterId": "products", "Match": { "Path": "/swagger/products/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger/products" } ] }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://auth-service:8080/" } } },
      "users": { "Destinations": { "d1": { "Address": "http://users-service:8080/" } } },
      "products": { "Destinations": { "d1": { "Address": "http://products-service:8080/" } } }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } },
      { "Name": "File", "Args": { "path": "logs/log-tecnico-.json", "rollingInterval": "Day", "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } }
    ]
  }
}
