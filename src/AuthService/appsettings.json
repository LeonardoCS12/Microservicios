{
  "CorsOrigins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:8080" ],
  "Jwt": {
    "Issuer": "apitienda",
    "Audience": "apitienda_users",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PrivateKeyPath": "/app/keys/private.pem",
    "PublicKeyPath": "/app/keys/public.pem"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } },
      { "Name": "File", "Args": { "path": "logs/log-tecnico-.json", "rollingInterval": "Day", "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } }
    ]
  }
}
